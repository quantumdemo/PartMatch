# ==============================================================================
# PartMatch Production Environment Configuration File Example (.env.example)
# STAGE 1: Foundation Setup
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Database, Auth, Storage, Realtime, RLS)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Sign up / Log in to https://supabase.com/dashboard
# 2. Create a new project named "PartMatch-Prod" or select your existing project.
# 3. Go to Project Settings -> API.
# 4. Copy "Project URL" for NEXT_PUBLIC_SUPABASE_URL.
# 5. Copy "anon public" key for NEXT_PUBLIC_SUPABASE_ANON_KEY.
# 6. Copy "service_role secret" key for SUPABASE_SERVICE_ROLE_KEY (keep server-side only!).
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. PAYSTACK PAYMENT GATEWAY (Nigeria NGN Payments & Webhooks)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Sign up / Log in to https://dashboard.paystack.com
# 2. Go to Settings -> API Keys & Webhooks.
# 3. Copy "Public Key" for NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY.
# 4. Copy "Secret Key" for PAYSTACK_SECRET_KEY.
# 5. Set your Webhook URL to: https://yourdomain.com/api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# ------------------------------------------------------------------------------
# 3. RESEND TRANSACTIONAL EMAIL (Verification Codes & Order Notifications)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Sign up at https://resend.com
# 2. Go to API Keys -> Create API Key with full access.
# 3. Verify your sending domain (e.g., partmatch.ng) under Domains.
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Social Sign-In)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Go to Google Cloud Console: https://console.cloud.google.com
# 2. Create a project "PartMatch".
# 3. Go to APIs & Services -> Credentials -> Create Credentials -> OAuth client ID.
# 4. Set Authorized Redirect URIs to: https://<your-supabase-id>.supabase.co/auth/v1/callback
# 5. Copy Client ID and Client Secret into Supabase Authentication -> Providers -> Google.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ------------------------------------------------------------------------------
# 5. MAPBOX & LOCATION SERVICES (Mechanic Map & Route Calculation)
# ------------------------------------------------------------------------------
# HOW TO GET:
# 1. Sign up at https://mapbox.com or https://account.mapbox.com
# 2. Go to Access Tokens -> Create default public token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoicGFydG1hdGNoIiwiYSI6ImN...

# ------------------------------------------------------------------------------
# 6. SECURITY & ADMIN CONFIGURATION
# ------------------------------------------------------------------------------
# HOW TO GET:
# - ADMIN_SECRET_PATH: Custom secret obfuscated URL route for admin web dashboard access.
# - SUPER_ADMIN_EMAILS: Comma-separated list of pre-authorized platform super admin emails.
ADMIN_SECRET_PATH=admin-portal-sec-x92f
SUPER_ADMIN_EMAILS=admin@partmatch.ng,techops@partmatch.ng
