# PartMatch Environment Configuration Guide
# How to obtain each API key is detailed in comments below.

# Supabase API Credentials
# Obtain from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Paystack Payment Gateway API Credentials
# Obtain from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"

# Resend Transactional Email API Key
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_your_resend_key"

# OpenAI API Key (For gpt-4o-mini Vision AI Auto-Fill & Diagnostics)
# Obtain from https://platform.openai.com/api-keys ($0.002 per scan)
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Mapbox Maps GL Access Token
# Obtain from https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.example"

# Application Public Host URL
NEXT_PUBLIC_APP_URL="https://partmatch.ng"

# Admin & Security Routing
ADMIN_SECRET_PATH="/admin"
SUPER_ADMIN_EMAILS="admin@partmatch.ng"
